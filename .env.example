# Copy this file to .env for local non-Docker development.
# For Docker Compose, docker-compose.yml sets DATABASE_URL to the compose database service.
DATABASE_URL=sqlite:///./beautypulse.db
ENABLE_DEMO_SEED=true
ENABLE_REVIEW_EMBEDDINGS=true

# Optional. The app works without a key using SQL analytics + lexical review retrieval.
# Add a key to enable OpenAI report synthesis and text-embedding-3-small review embeddings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Comma-separated origins; '*' is fine for a same-origin single-service deployment.
CORS_ORIGINS=*
